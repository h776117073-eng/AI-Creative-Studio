{
  "name":"ai-creative-studio","version":"1.1.0","private":true,"workspaces":["packages/*","apps/*"],
  "scripts":{"dev":"concurrently \"npm run dev:web\" \"npm run dev:api\"","dev:web":"npm run dev -w @ai-creative-studio/web","dev:api":"npm run dev -w @ai-creative-studio/api","build":"npm run build:core && npm run build:engines && npm run build:apps && npm run build:api","build:core":"npm run build -w @ai-creative-studio/core","build:engines":"for config in packages/*/tsconfig.json; do npx tsc -p \"$config\" || exit $?; done","build:apps":"npm run build -w @ai-creative-studio/web","build:api":"npm run build -w @ai-creative-studio/api","test":"npm run test --workspaces","test:api":"npm run test -w @ai-creative-studio/api","lint":"eslint packages apps --ext .ts,.tsx","typecheck":"npm run build:core && npm run build:engines && npm run build:apps && npm run build:api"},
  "devDependencies":{"@types/node":"^20.14.0","@types/react":"^18.3.3","@types/react-dom":"^18.3.3","@typescript-eslint/eslint-plugin":"^8.62.1","@typescript-eslint/parser":"^8.62.1","concurrently":"^8.2.2","eslint":"^8.57.0","typescript":"^5.5.0"},
  "dependencies":{"@ffmpeg/ffmpeg":"^0.12.15","@ffmpeg/util":"^0.12.2","better-sqlite3":"^11.1.2","jsonwebtoken":"^9.0.2","pg":"^8.12.0","stripe":"^16.2.0","zod":"^3.23.8"},
  "engines":{"node":">=20.0.0"}
}
